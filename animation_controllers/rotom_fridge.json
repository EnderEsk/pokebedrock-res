{
  "format_version": "1.18.20",
  "animation_controllers": {
    "controller.animation.rotom_fridge": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": [
            "idle"
          ],
          "transitions": [
            {
              "opening": "query.property('pokeb:appliance_state') == 'opening'"
            },
            {
              "using": "query.property('pokeb:appliance_state') == 'transforming'"
            }
          ]
        },
        "opening": {
          "animations": [
            "open"
          ],
          "transitions": [
            {
              "closing": "query.property('pokeb:appliance_state') == 'closing'"
            },
            {
              "using": "query.property('pokeb:appliance_state') == 'transforming'"
            },
            {
              "default": "query.property('pokeb:appliance_state') == 'idle'"
            }
          ]
        },
        "closing": {
          "animations": [
            "close"
          ],
          "transitions": [
            {
              "using": "query.property('pokeb:appliance_state') == 'transforming'"
            },
            {
              "default": "query.property('pokeb:appliance_state') == 'idle'"
            }
          ]
        },
        "using": {
          "animations": [
            "rotom_use"
          ],
          "transitions": [
            {
              "default": "query.property('pokeb:appliance_state') != 'transforming'"
            }
          ]
        }
      }
    }
  }
}
