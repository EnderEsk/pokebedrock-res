{
  "format_version": "1.18.20",
  "animation_controllers": {
    "controller.animation.rotom_microwave": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": [
            "idle"
          ],
          "transitions": [
            {
              "using": "query.property('pokeb:appliance_state') == 'transforming'"
            }
          ]
        },
        "using": {
          "animations": [
            "rotom_use"
          ],
          "transitions": [
            {
              "default": "query.property('pokeb:appliance_state') != 'transforming'"
            }
          ]
        }
      }
    }
  }
}